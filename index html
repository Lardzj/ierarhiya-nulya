// STATE
let S = { vnIdx: 0, chIdx: 0, wikiTab: 'chars', selWiki: null, madness: 15, relation: 0, history: [], quoteT: null, secretTaps: 0, reputations: {lira: 0, azar: 0, reyn: 0} };

// INIT - show lobby after short delay
setTimeout(function() {
  document.getElementById('splash').classList.remove('show');
  go('lobby');
}, 2000);

// NAVIGATION
function go(name) {
  document.querySelectorAll('.page').forEach(function(p) { p.classList.remove('show'); });
  document.getElementById(name).classList.add('show');
  document.querySelectorAll('.nav-btn').forEach(function(b) { b.classList.remove('on'); });
  if(name === 'reading') { renderReading(); }
  if(name === 'wiki') { renderWiki(); }
  if(name === 'vn') { renderVN(); }
  if(name === 'diary') { renderDiary(); }
  if(name === 'lobby') { updateLobby(); checkRandomEvent(); }
  window.scrollTo(0,0);
}

// LOBBY
function kyronTalk() {
  var q = QUOTES[Math.floor(Math.random() * QUOTES.length)];
  var qb = document.getElementById('quote-box');
  var th = document.getElementById('tap-hint');
  qb.textContent = '«' + q + '»';
  qb.style.display = 'block';
  th.style.display = 'none';
  clearTimeout(S.quoteT);
  S.quoteT = setTimeout(function() { qb.style.display = 'none'; th.style.display = 'block'; }, 4000);
}
function openWardrobe() { document.getElementById('wardrobe-modal').classList.add('show'); }
function closeWardrobe() { document.getElementById('wardrobe-modal').classList.remove('show'); }

// READING
function renderReading() {
  var tabs = document.getElementById('ch-tabs');
  tabs.innerHTML = ['Глава 1'].map(function(t,i) {
    return '<button class="ch-tab '+(i===S.chIdx?'on':'off')+'" onclick="setCh('+i+')">'+t+'</button>';
  }).join('');
  document.getElementById('ch-body').innerHTML = CH_TEXTS[S.chIdx];
  document.getElementById('prev-btn').disabled = true;
  document.getElementById('next-btn').disabled = true;
}
function setCh(i) { S.chIdx = i; renderReading(); window.scrollTo(0,0); }
function prevCh() { if(S.chIdx > 0) { S.chIdx--; renderReading(); window.scrollTo(0,0); } }
function nextCh() { }

// WIKI
function renderWiki() {
  document.getElementById('wtab-chars').className = 'wiki-tab ' + (S.wikiTab==='chars'?'on':'off');
  document.getElementById('wtab-lore').className = 'wiki-tab ' + (S.wikiTab==='lore'?'on':'off');
  var items = S.wikiTab === 'chars' ? CHARS : LORE;
  document.getElementById('wiki-list').innerHTML = items.map(function(item) {
    var nm = S.wikiTab==='chars' ? item.name : item.title;
    return '<button class="wiki-item '+(S.selWiki===item.id?'on':'off')+'" onclick="selWiki(\''+item.id+'\')">' + nm + '</button>';
  }).join('');
  renderWikiDetail();
}
function setWikiTab(t) { S.wikiTab = t; S.selWiki = null; renderWiki(); document.getElementById('wiki-detail').innerHTML = '<div class="wiki-empty">Выберите запись</div>'; }
function selWiki(id) { S.selWiki = id; renderWiki(); renderWikiDetail(); }
function renderWikiDetail() {
  if(!S.selWiki) return;
  var items = S.wikiTab === 'chars' ? CHARS : LORE;
  var item = items.find(function(i) { return i.id === S.selWiki; });
  if(!item) return;
  var html = '';
  if(S.wikiTab === 'chars') {
    html = (item.img ? '<img class="wiki-img" src="'+item.img+'" referrerpolicy="no-referrer" alt=""/>' : '') +
      '<div class="wiki-label">'+item.title+'</div>' +
      '<div class="wiki-name">'+item.name+'</div>' +
      '<div class="wiki-desc">'+item.desc+'</div>' +
      '<div>'+item.traits.map(function(t){return '<span class="trait">'+t+'</span>';}).join('')+'</div>' +
      '<div class="wiki-status">'+item.status+'</div>';
  } else {
    html = '<div class="wiki-label">Архивная запись</div>' +
      '<div class="wiki-name">'+item.title+'</div>' +
      '<div class="wiki-desc">'+item.content+'</div>';
  }
  document.getElementById('wiki-detail').innerHTML = html;
}

// VN
function renderVN() {
  var sc = SCENES[S.vnIdx];
  if(!sc) return;
  document.getElementById('vn-bg').src = sc.bg;
  var cw = document.getElementById('vn-char-wrap');
  if(sc.char) { document.getElementById('vn-char-img').src = sc.char; cw.style.display = 'flex'; }
  else { cw.style.display = 'none'; }
  var nt = document.getElementById('name-tag');
  if(sc.speaker) { document.getElementById('vn-speaker').textContent = sc.speaker; nt.style.display = 'block'; }
  else { nt.style.display = 'none'; }
  document.getElementById('vn-text').textContent = sc.text;
  var co = document.getElementById('choices-overlay');
  var dot = document.getElementById('vn-dot');
  if(sc.choices) {
    document.getElementById('choices-list').innerHTML = sc.choices.map(function(c,i) {
      return '<button class="choice-btn" onclick="makeChoice('+i+')">'+c.text+'</button>';
    }).join('');
    co.style.display = 'flex';
    dot.parentElement.style.display = 'none';
  } else {
    co.style.display = 'none';
    dot.parentElement.style.display = 'flex';
  }
  document.getElementById('vn-prog').style.width = ((S.vnIdx+1)/SCENES.length*100)+'%';
  document.getElementById('mad-fill').style.width = S.madness+'%';
  document.getElementById('mad-pct').textContent = S.madness+'%';
  document.getElementById('mad-val').textContent = S.madness+'%';
  if(sc.text && sc.speaker !== undefined) {
    S.history.push({speaker: sc.speaker||'???', text: sc.text});
    if(S.history.length > 50) S.history.shift();
  }
}

document.getElementById('vn').addEventListener('click', function(e) {
  if(e.target.closest('.vn-icon-btn') || e.target.closest('.choices-overlay') || e.target.closest('.vn-dialogue')) return;
  advance();
});
document.getElementById('vn-dialogue').addEventListener('click', function() { advance(); });

function advance() {
  var sc = SCENES[S.vnIdx];
  if(sc.choices) return;
  if(sc.next === null) return;
  var ni = SCENES.findIndex(function(s) { return s.id === sc.next; });
  if(ni !== -1) { S.vnIdx = ni; renderVN(); saveProgress(); }
}
function makeChoice(idx) {
  var sc = SCENES[S.vnIdx];
  var c = sc.choices[idx];
  if(c.stat) { S.madness = Math.min(100, Math.max(0, S.madness + c.stat)); }
  var ni = SCENES.findIndex(function(s) { return s.id === c.next; });
  if(ni !== -1) { S.vnIdx = ni; renderVN(); saveProgress(); }
}

// HISTORY
function openHist() {
