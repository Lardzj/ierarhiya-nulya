  if(old < 50 && newVal >= 50) showRelationEvent("«Моя Пустота затихает когда ты рядом. Не уходи.»", "50% — особая сцена разблокирована");
  if(old < 75 && newVal >= 75) showRelationEvent("«Я написал кое-что для тебя. Найди в дневнике.»", "75% — запись Кайрона в дневнике");
  if(old < 100 && newVal >= 100) showRelationEvent("«Ты — моё. Навсегда. И я — твой.»", "100% — тайная сцена разблокирована 🖤");
}

