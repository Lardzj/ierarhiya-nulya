// Нажатие на Кайрона — повышает связь раз в 10 сек
var origKyronTalk = kyronTalk;
function kyronTalk() {
  var now = Date.now();
  if(now - lastTapTime > TAP_COOLDOWN) {
    lastTapTime = now;
    addRelation(1);
    // Показываем разные фразы в зависимости от связи
    var q;
    if(S.relation >= 75) {
      var highQuotes = ["Ты знаешь что я не отпущу тебя. И ты остаёшься. Это всё что мне нужно.", "Твоё имя — единственное слово которое заставляет мою Пустоту замолчать.", "Я бы сжёг все миры ради одной твоей улыбки. И не пожалел бы."];
      q = highQuotes[Math.floor(Math.random() * highQuotes.length)];
    } else if(S.relation >= 50) {
      var midQuotes = ["Ты остаёшься. Это... важно для меня.", "Я замечаю тебя. Каждую секунду. Даже когда ты не видишь меня.", "Моя Пустота тихая когда ты рядом."];
      q = midQuotes[Math.floor(Math.random() * midQuotes.length)];
    } else if(S.relation >= 25) {
      var lowQuotes = ["Ты начинаешь привыкать. Хорошо.", "Я вижу что ты смотришь на меня иначе.", "Три года я ждал этого момента."];
      q = lowQuotes[Math.floor(Math.random() * lowQuotes.length)];
    } else {
      q = QUOTES[Math.floor(Math.random() * QUOTES.length)];
    }
    var qb = document.getElementById('quote-box');
    var th = document.getElementById('tap-hint');
    qb.textContent = '«' + q + '»';
    qb.style.display = 'block';
    th.style.display = 'none';
    clearTimeout(S.quoteT);
    S.quoteT = setTimeout(function() { qb.style.display = 'none'; th.style.display = 'block'; }, 5000);
  } else {
    // Кулдаун ещё не прошёл
    var remaining = Math.ceil((TAP_COOLDOWN - (Date.now() - lastTapTime)) / 1000);
    var qb = document.getElementById('quote-box');
    var th = document.getElementById('tap-hint');
    qb.textContent = '...подожди ещё ' + remaining + ' сек';
    qb.style.display = 'block';
    th.style.display = 'none';
    clearTimeout(S.quoteT);
    S.quoteT = setTimeout(function() { qb.style.display = 'none'; th.style.display = 'block'; }, 2000);
  }
}

function toggleSound() {
  soundOn = !soundOn;
  document.getElementById('sound-toggle').textContent = soundOn ? 'ВКЛ' : 'ВЫКЛ';
  document.getElementById('sound-toggle').style.borderColor = soundOn ? '#ff4e00' : 'rgba(255,255,255,0.2)';
  document.getElementById('sound-toggle').style.color = soundOn ? '#ff4e00' : 'rgba(255,255,255,0.3)';
}

function resetProgress() {
  if(confirm('Сбросить весь прогресс? Это действие нельзя отменить.')) {
    S.vnIdx = 0;
    S.madness = 15;
    S.relation = 0;
    S.history = [];
    closeSettings();
    alert('Прогресс сброшен 🖤');
  }
}
</script>
