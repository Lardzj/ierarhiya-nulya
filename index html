<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
<title>Иерархия Нуля</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { width: 100%; height: 100%; background: #0a0502; color: #e0d8d0; font-family: Georgia, serif; }

/* SCREENS */
.page { display: none; width: 100%; min-height: 100%; flex-direction: column; }
.page.show { display: flex; }

/* SPLASH */
#splash {
  background: #000;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}
.splash-box { text-align: center; }
.splash-title { font-size: 1.8rem; font-weight: 300; letter-spacing: 0.5em; text-transform: uppercase; color: #fff; margin-bottom: 0.5rem; }
.splash-sub { font-size: 0.6rem; letter-spacing: 0.3em; text-transform: uppercase; color: rgba(255,255,255,0.3); margin-bottom: 2rem; }
.splash-line { width: 8rem; height: 1px; background: rgba(255,255,255,0.1); margin: 0 auto; overflow: hidden; position: relative; }
.splash-line::after { content: ''; position: absolute; inset: 0; background: #ff4e00; animation: slide 1.5s linear infinite; }
@keyframes slide { from { transform: translateX(-100%); } to { transform: translateX(100%); } }

/* NAV */
.bottom-nav {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: rgba(10,5,2,0.95);
  border-top: 1px solid rgba(255,200,150,0.1);
  display: flex;
  justify-content: space-around;
  padding: 0.75rem 0.5rem;
  z-index: 100;
}
.nav-btn { background: none; border: none; cursor: pointer; color: rgba(255,255,255,0.25); display: flex; flex-direction: column; align-items: center; gap: 0.2rem; padding: 0.25rem 0.5rem; }
.nav-btn.on { color: #ff4e00; }
.nav-btn svg { width: 1.3rem; height: 1.3rem; }
.nav-btn span { font-size: 0.45rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; font-family: sans-serif; }

/* HEADER */
.top-bar {
  position: fixed;
  top: 0; left: 0; right: 0;
  background: rgba(10,5,2,0.9);
  border-bottom: 1px solid rgba(255,200,150,0.1);
  padding: 0.75rem 1rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  z-index: 100;
}
.top-bar-title { font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.5); font-family: sans-serif; }

/* LOBBY */
#lobby { position: relative; min-height: 100vh; overflow: hidden; }
.lobby-bg-img {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  opacity: 0.45;
  z-index: 0;
}
.lobby-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, #0a0502 30%, transparent 70%);
  z-index: 1;
}
.lobby-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-top: 3.5rem;
  padding-bottom: 5rem;
}
.lobby-header {
  padding: 1rem 1.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.lobby-title { font-size: 1.2rem; font-weight: 300; letter-spacing: 0.4em; text-transform: uppercase; color: #fff; font-family: sans-serif; }
.lobby-live {
  font-size: 0.45rem; letter-spacing: 0.1em; text-transform: uppercase;
  color: #ff4e00; background: rgba(255,78,0,0.2);
  border: 1px solid rgba(255,78,0,0.4);
  padding: 0.15rem 0.4rem; border-radius: 0.25rem;
  margin-left: 0.5rem; font-family: sans-serif;
}
.currency-row { display: flex; gap: 0.5rem; }
.chip {
  display: flex; align-items: center; gap: 0.3rem;
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.1);
  padding: 0.3rem 0.6rem; border-radius: 0.75rem;
  font-size: 0.6rem; font-family: monospace; color: rgba(255,255,255,0.8);
}

.char-area {
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  position: relative;
  min-height: 300px;
}

/* ПЕПЕЛ */
#ash-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 3;
}
.kyron-img {
  height: 420px;
  max-height: 65vh;
  width: auto;
  object-fit: contain;
  object-position: top;
  cursor: pointer;
  position: relative;
  z-index: 2;
}
.quote-box {
  display: none;
  position: absolute;
  top: -5rem;
  left: 50%; transform: translateX(-50%);
  width: 16rem;
  background: rgba(0,0,0,0.85);
  border: 1px solid rgba(255,78,0,0.4);
  border-radius: 1rem;
  padding: 0.85rem 1rem;
  font-style: italic;
  font-size: 0.8rem;
  text-align: center;
  color: rgba(255,255,255,0.9);
  z-index: 20;
  box-shadow: 0 0 20px rgba(255,78,0,0.15);
}
.tap-hint {
  position: absolute;
  top: 1rem;
  left: 50%; transform: translateX(-50%);
  font-size: 0.5rem; letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.3);
  font-family: sans-serif;
  white-space: nowrap;
}

.side-btns-left {
  position: absolute;
  left: 0.75rem; top: 50%; transform: translateY(-50%);
  display: flex; flex-direction: column; gap: 0.5rem;
  z-index: 5;
}
.side-btns-right {
  position: absolute;
  right: 0.75rem; top: 50%; transform: translateY(-50%);
  display: flex; flex-direction: column; gap: 0.5rem;
  z-index: 5;
}
.side-btn {
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 0.75rem;
  padding: 0.6rem;
  cursor: pointer;
  display: flex; flex-direction: column; align-items: center; gap: 0.25rem;
}
.side-btn svg { width: 1.1rem; height: 1.1rem; color: #ff4e00; }
.side-btn span { font-size: 0.38rem; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255,255,255,0.4); font-family: sans-serif; }
.stat-chip {
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 0.75rem;
  padding: 0.6rem;
  display: flex; flex-direction: column; align-items: center; gap: 0.25rem;
}
.stat-chip svg { width: 1.1rem; height: 1.1rem; }
.stat-val { font-size: 0.6rem; font-family: monospace; color: rgba(255,255,255,0.8); }
.stat-lbl { font-size: 0.38rem; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255,255,255,0.3); font-family: sans-serif; }

.lobby-bottom {
  padding: 1rem 1.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
}
.action-row { display: flex; gap: 0.75rem; width: 100%; max-width: 22rem; }
.action-btn {
  flex: 1;
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 0.75rem;
  padding: 0.75rem;
  cursor: pointer;
  display: flex; flex-direction: column; align-items: center; gap: 0.35rem;
}
.action-btn svg { width: 1rem; height: 1rem; color: rgba(255,255,255,0.4); }
.action-btn span { font-size: 0.5rem; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.5); font-family: sans-serif; }
.play-btn {
  width: 100%; max-width: 22rem;
  background: #ff4e00;
  border: none;
  border-radius: 1rem;
  padding: 1.1rem;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center; gap: 0.75rem;
  box-shadow: 0 0 30px rgba(255,78,0,0.4);
}
.play-btn svg { width: 1.3rem; height: 1.3rem; fill: #000; }
.play-btn span { font-size: 0.9rem; font-weight: 600; letter-spacing: 0.3em; text-transform: uppercase; color: #000; font-family: sans-serif; }

/* MODAL */
.modal {
  display: none;
  position: fixed; inset: 0; z-index: 200;
  background: rgba(0,0,0,0.85);
  align-items: flex-end; justify-content: center;
}
.modal.show { display: flex; }
.modal-box {
  width: 100%; max-width: 36rem;
  background: #120a05;
  border-top: 1px solid rgba(255,255,255,0.1);
  border-radius: 2rem 2rem 0 0;
  padding: 1.5rem;
  display: flex; flex-direction: column; gap: 1rem;
}
.modal-head { display: flex; justify-content: space-between; align-items: center; }
.modal-head-title { font-size: 1rem; font-weight: 300; letter-spacing: 0.3em; text-transform: uppercase; font-family: sans-serif; }
.modal-close { background: none; border: none; color: rgba(255,255,255,0.4); cursor: pointer; font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase; font-family: sans-serif; }
.costume-item {
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 0.75rem;
  padding: 0.75rem;
  cursor: pointer;
}
.costume-item.active { border-color: #ff4e00; background: rgba(255,78,0,0.1); }
.costume-name { font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; color: #fff; font-family: sans-serif; }
.costume-desc { font-size: 0.6rem; line-height: 1.5; color: rgba(255,255,255,0.5); margin-top: 0.2rem; font-family: sans-serif; }

/* READING */
#reading { padding-top: 3.5rem; padding-bottom: 5rem; }
.reading-inner { max-width: 40rem; margin: 0 auto; padding: 1.25rem; }
.ch-tabs { display: flex; gap: 0.5rem; margin-bottom: 1rem; overflow-x: auto; }
.ch-tabs::-webkit-scrollbar { display: none; }
.ch-tab {
  padding: 0.4rem 0.75rem;
  border-radius: 0.5rem;
  border: none;
  font-size: 0.55rem; letter-spacing: 0.1em; text-transform: uppercase;
  cursor: pointer; white-space: nowrap; font-family: sans-serif;
}
.ch-tab.on { background: rgba(255,78,0,0.15); border: 1px solid rgba(255,78,0,0.3); color: #ff4e00; }
.ch-tab.off { background: rgba(255,255,255,0.07); color: rgba(255,255,255,0.35); border: 1px solid transparent; }
.ch-body {
  background: rgba(255,80,20,0.06);
  border: 1px solid rgba(255,200,150,0.1);
  border-radius: 1.5rem;
  padding: 1.5rem;
}
.ch-body h1 { font-size: 1.6rem; font-weight: 300; color: #fff; margin-bottom: 1rem; letter-spacing: -0.02em; }
.ch-body h3 { font-size: 1.1rem; font-style: italic; color: rgba(255,255,255,0.8); margin: 1.5rem 0 0.75rem; }
.ch-body p { font-size: 1rem; line-height: 1.85; color: rgba(224,216,208,0.85); margin-bottom: 1rem; }
.ch-body hr { border: none; height: 1px; background: rgba(255,200,150,0.1); margin: 1.5rem 0; }
.ch-arrows { display: flex; justify-content: center; gap: 2rem; margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid rgba(255,255,255,0.05); }
.arr-btn {
  background: none; border: 1px solid rgba(255,255,255,0.15);
  border-radius: 50%; padding: 0.75rem; cursor: pointer; color: rgba(255,255,255,0.6);
}
.arr-btn:disabled { opacity: 0.2; cursor: not-allowed; }
.arr-btn svg { width: 1.2rem; height: 1.2rem; display: block; }

/* WIKI */
#wiki { padding-top: 3.5rem; padding-bottom: 5rem; }
.wiki-inner { max-width: 40rem; margin: 0 auto; padding: 1.25rem; display: flex; flex-direction: column; gap: 0.75rem; }
.wiki-tabs-row { display: flex; gap: 0.5rem; }
.wiki-tab {
  flex: 1; padding: 0.5rem;
  border: none; border-radius: 0.5rem; cursor: pointer;
  font-size: 0.55rem; letter-spacing: 0.1em; text-transform: uppercase; font-family: sans-serif;
}
.wiki-tab.on { background: #ff4e00; color: #000; }
.wiki-tab.off { background: rgba(255,255,255,0.07); color: rgba(255,255,255,0.4); }
.wiki-list { display: flex; flex-direction: column; gap: 0.2rem; }
.wiki-item {
  padding: 0.6rem 0.85rem; border-radius: 0.6rem;
  border: none; cursor: pointer; text-align: left;
  font-size: 0.7rem; letter-spacing: 0.05em; font-family: sans-serif;
}
.wiki-item.on { background: rgba(255,255,255,0.12); color: #fff; }
.wiki-item.off { background: transparent; color: rgba(255,255,255,0.4); }
.wiki-detail {
  background: rgba(255,80,20,0.06);
  border: 1px solid rgba(255,200,150,0.1);
  border-radius: 1.5rem;
  padding: 1.5rem;
  min-height: 10rem;
}
.wiki-empty { text-align: center; opacity: 0.25; padding: 2rem; font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; font-family: sans-serif; }
.wiki-label { font-size: 0.55rem; letter-spacing: 0.3em; text-transform: uppercase; color: #ff4e00; margin-bottom: 0.5rem; font-family: sans-serif; }
.wiki-name { font-size: 2rem; font-weight: 300; color: #fff; margin-bottom: 0.75rem; }
.wiki-desc { color: rgba(255,255,255,0.6); line-height: 1.7; font-size: 0.9rem; margin-bottom: 0.75rem; }
.wiki-img { width: 100%; max-height: 14rem; object-fit: contain; border-radius: 0.75rem; margin-bottom: 0.75rem; border: 1px solid rgba(255,255,255,0.1); }
.trait { display: inline-block; padding: 0.2rem 0.5rem; border-radius: 2rem; background: rgba(255,78,0,0.1); color: #ff4e00; font-size: 0.5rem; letter-spacing: 0.1em; text-transform: uppercase; border: 1px solid rgba(255,78,0,0.2); margin: 0.15rem; font-family: sans-serif; }
.wiki-status { color: rgba(255,255,255,0.8); font-size: 0.8rem; font-style: italic; padding: 0.6rem 0.85rem; background: rgba(255,255,255,0.05); border-radius: 0.5rem; margin-top: 0.5rem; }

/* VN */
#vn { position: relative; min-height: 100vh; background: #000; overflow: hidden; }
.vn-bg-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
.vn-grad { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 50%, rgba(0,0,0,0.2) 100%); z-index: 1; }
.vn-char-wrap { position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); height: 75%; z-index: 2; display: flex; align-items: flex-end; }
.vn-char-wrap img { height: 100%; width: auto; object-fit: contain; object-position: bottom; }

.vn-top { position: absolute; top: 0; left: 0; right: 0; z-index: 10; padding: 0.75rem 1rem; padding-top: 3.5rem; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
.madness-wrap { width: 90%; max-width: 20rem; }
.madness-label { display: flex; justify-content: space-between; font-size: 0.5rem; font-weight: 700; color: #f43f5e; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.25rem; font-family: sans-serif; }
.madness-bar { height: 0.4rem; background: rgba(0,0,0,0.9); border-radius: 2rem; overflow: hidden; border: 1px solid rgba(153,27,27,0.5); }
.madness-fill { height: 100%; background: linear-gradient(to right, #4c0519, #dc2626); transition: width 1s; }
.escape-txt { font-size: 0.5rem; letter-spacing: 0.2em; color: #ef4444; font-weight: 700; text-transform: uppercase; background: rgba(0,0,0,0.6); padding: 0.35rem 0.65rem; border-radius: 0.35rem; border: 1px solid rgba(153,27,27,0.4); font-family: sans-serif; }

.vn-icon-btn { position: absolute; z-index: 20; background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.15); border-radius: 50%; padding: 0.6rem; cursor: pointer; color: #fff; }
.vn-icon-btn svg { width: 1rem; height: 1rem; display: block; }
#vn-back { top: 3.5rem; left: 0.75rem; }
#vn-hist { top: 3.5rem; right: 0.75rem; }
#vn-save { top: 7rem; right: 0.75rem; }
#vn-restart { top: 10.5rem; right: 0.75rem; }
.vn-save-toast {
  position: absolute;
  bottom: 12rem;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0,0,0,0.85);
  border: 1px solid rgba(255,78,0,0.4);
  border-radius: 2rem;
  padding: 0.5rem 1.25rem;
  font-size: 0.65rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #ff4e00;
  font-family: sans-serif;
  z-index: 50;
  display: none;
  white-space: nowrap;
}

.vn-dialogue { position: absolute; bottom: 1.5rem; left: 0.75rem; right: 0.75rem; z-index: 15; }
.name-tag { display: inline-block; padding: 0.25rem 1.25rem; background: linear-gradient(to bottom, #374151, #111827); border: 2px solid #6b7280; border-radius: 0.35rem; margin-bottom: -2px; position: relative; z-index: 1; }
.name-tag span { color: #fff; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.05em; font-family: sans-serif; }
.dialogue-box { background: linear-gradient(to bottom, #f1f5f9, rgba(203,213,225,0.97)); border: 2px solid #94a3b8; border-radius: 0.75rem; padding: 0.85rem 1rem; min-height: 4rem; }
.dialogue-box p { color: #0f172a; font-size: 1rem; font-weight: 500; line-height: 1.6; letter-spacing: 0.01em; font-family: sans-serif; }
.dot-ind { display: flex; justify-content: flex-end; margin-top: 0.4rem; }
.dot-ind div { width: 0.4rem; height: 0.4rem; border-radius: 50%; background: #64748b; animation: blink 2s ease infinite; }
@keyframes blink { 0%,100%{opacity:0.4} 50%{opacity:1} }

.choices-overlay { position: absolute; inset: 0; z-index: 25; display: flex; align-items: center; justify-content: center; padding: 1.5rem; background: rgba(0,0,0,0.2); }
.choices-list { display: flex; flex-direction: column; gap: 0.75rem; width: 100%; max-width: 22rem; }
.choice-btn { padding: 0.9rem 1rem; border-radius: 0.75rem; background: rgba(241,245,249,0.96); border: 2px solid #94a3b8; color: #0f172a; font-size: 0.95rem; font-weight: 500; cursor: pointer; text-align: center; font-family: sans-serif; }
.vn-progress { position: absolute; top: 0; left: 0; right: 0; height: 0.2rem; background: rgba(255,255,255,0.05); z-index: 30; }
.vn-progress-fill { height: 100%; background: rgba(255,78,0,0.7); transition: width 0.5s; }

.notif { position: absolute; top: 13rem; left: 0.75rem; z-index: 50; padding: 0.6rem 1rem; border-radius: 0.75rem; font-size: 0.8rem; font-weight: 500; font-family: sans-serif; }
.notif.pos { background: rgba(6,78,59,0.9); border: 1px solid rgba(16,185,129,0.5); color: #d1fae5; }
.notif.neg { background: rgba(127,29,29,0.9); border: 1px solid rgba(239,68,68,0.5); color: #fee2e2; }

/* HISTORY */
.hist-overlay { display: none; position: fixed; inset: 0; z-index: 200; background: rgba(0,0,0,0.9); align-items: center; justify-content: center; padding: 1rem; }
.hist-overlay.show { display: flex; }
.hist-box { width: 100%; max-width: 36rem; max-height: 80vh; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 1.5rem; overflow: hidden; display: flex; flex-direction: column; }
.hist-head { padding: 1rem 1.25rem; border-bottom: 1px solid rgba(255,255,255,0.1); display: flex; justify-content: space-between; align-items: center; }
.hist-head-title { font-size: 0.6rem; letter-spacing: 0.3em; text-transform: uppercase; color: #ff4e00; font-family: sans-serif; }
.hist-body { flex: 1; overflow-y: auto; padding: 1.25rem; display: flex; flex-direction: column; gap: 1.25rem; }
.hist-entry { border-left: 1px solid rgba(255,78,0,0.2); padding-left: 0.75rem; }
.hist-speaker { font-size: 0.5rem; letter-spacing: 0.2em; text-transform: uppercase; color: #ff4e00; opacity: 0.7; display: block; margin-bottom: 0.2rem; font-family: sans-serif; }
.hist-text { color: rgba(255,255,255,0.8); font-size: 1rem; line-height: 1.6; }
</style>
</head>
<body>

<!-- SPLASH -->
<div class="page show" id="splash">
  <div class="splash-box">
    <div class="splash-title">Иерархия Нуля</div>
    <div class="splash-sub">Визуальная новелла</div>
    <div class="splash-line"></div>
  </div>
</div>

<!-- LOBBY -->
<div class="page" id="lobby">
  <img class="lobby-bg-img" src="https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&q=80&w=1920" referrerpolicy="no-referrer" alt="bg"/>
  <div class="lobby-overlay"></div>
  <div class="top-bar">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ff4e00" stroke-width="1.5"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
    <span class="top-bar-title">Иерархия Нуля</span>
  </div>
  <div class="lobby-content">
    <div class="lobby-header">
      <div>
        <span class="lobby-title">Лобби</span>
        <span class="lobby-live">Live</span>
        <div id="day-counter" style="font-size:0.45rem;letter-spacing:0.15em;color:rgba(255,78,0,0.6);font-family:sans-serif;margin-top:0.2rem;text-transform:uppercase"></div>
      </div>
      <div class="currency-row">
        <div class="chip">🗝 <span id="keys">10</span></div>
        <div class="chip">💎 <span id="gems">500</span></div>
      </div>
    </div>

    <div class="char-area">
      <canvas id="ash-canvas"></canvas>
